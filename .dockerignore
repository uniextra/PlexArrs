# Ignore Python cache files
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore Docker specific files
Dockerfile
.dockerignore
guia.txt
.gitignore
docker-compose*.yml

# Ignore Git and GitHub internal files (prevent secrets leaks)
.git/
.github/
.agent/

# Environment files, documentation and local notes
*.env*
.env*
*.txt
*.md

# Ignore virtual environment folders
venv/
.venv/
env/
.env/
